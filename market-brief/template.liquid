<div style="font-family: sans-serif; padding: 18px 28px; background: #fff; color: #000; height: 480px; width: 800px; position: relative; overflow: hidden;">

  <!-- Header -->
  <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; border-bottom: 3px solid #000; padding-bottom: 6px;">
    <div style="font-size: 22px; font-weight: 800; letter-spacing: -0.5px;">📈 Daily Brief</div>
    <div style="font-size: 11px; color: #666;">{{ date }}</div>
  </div>

  <!-- Brief message -->
  <div style="font-size: 12px; line-height: 1.3; margin-bottom: 6px;">
    {{ brief }}
  </div>

  <!-- Trend summary -->
  <div style="font-size: 12px; font-weight: 700; line-height: 1.3; margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px dashed #ccc;">
    {{ trend_summary }}
  </div>

  <!-- Index row: S&P 500, Dow, Nasdaq, JPM -->
  <div style="display: flex; gap: 10px; margin-bottom: 10px;">

    <div style="flex: 1; border: 2px solid #000; padding: 7px 9px;">
      <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #666; margin-bottom: 3px;">
        {{ market_index_name | default: "S&P 500" }}
      </div>
      <div style="display: flex; align-items: baseline; gap: 5px;">
        <div style="font-size: 17px; font-weight: 800;">{{ market_price }}</div>
        <div style="font-size: 11px; font-weight: 700;">
          {% if market_direction == "up" %}▲{% elsif market_direction == "down" %}▼{% else %}▪{% endif %}
          {{ market_change_pct }}%
        </div>
      </div>
      <div style="font-size: 10px; color: #666; margin-top: 2px;">
        5D: {% if market_week_direction == "up" %}▲{% elsif market_week_direction == "down" %}▼{% else %}▪{% endif %} {{ market_week_change_pct }}%
      </div>
    </div>

    <div style="flex: 1; border: 2px solid #000; padding: 7px 9px;">
      <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #666; margin-bottom: 3px;">
        Dow Jones
      </div>
      <div style="display: flex; align-items: baseline; gap: 5px;">
        <div style="font-size: 17px; font-weight: 800;">{{ dow_price }}</div>
        <div style="font-size: 11px; font-weight: 700;">
          {% if dow_direction == "up" %}▲{% elsif dow_direction == "down" %}▼{% else %}▪{% endif %}
          {{ dow_change_pct }}%
        </div>
      </div>
      <div style="font-size: 10px; color: #666; margin-top: 2px;">
        5D: {% if dow_week_direction == "up" %}▲{% elsif dow_week_direction == "down" %}▼{% else %}▪{% endif %} {{ dow_week_change_pct }}%
      </div>
    </div>

    <div style="flex: 1; border: 2px solid #000; padding: 7px 9px;">
      <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #666; margin-bottom: 3px;">
        Nasdaq
      </div>
      <div style="display: flex; align-items: baseline; gap: 5px;">
        <div style="font-size: 17px; font-weight: 800;">{{ nasdaq_price }}</div>
        <div style="font-size: 11px; font-weight: 700;">
          {% if nasdaq_direction == "up" %}▲{% elsif nasdaq_direction == "down" %}▼{% else %}▪{% endif %}
          {{ nasdaq_change_pct }}%
        </div>
      </div>
      <div style="font-size: 10px; color: #666; margin-top: 2px;">
        5D: {% if nasdaq_week_direction == "up" %}▲{% elsif nasdaq_week_direction == "down" %}▼{% else %}▪{% endif %} {{ nasdaq_week_change_pct }}%
      </div>
    </div>

    <div style="flex: 1; border: 2px solid #000; padding: 7px 9px;">
      <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #666; margin-bottom: 3px;">
        JPMorgan
      </div>
      <div style="display: flex; align-items: baseline; gap: 5px;">
        <div style="font-size: 17px; font-weight: 800;">{{ jpm_price }}</div>
        <div style="font-size: 11px; font-weight: 700;">
          {% if jpm_direction == "up" %}▲{% elsif jpm_direction == "down" %}▼{% else %}▪{% endif %}
          {{ jpm_change_pct }}%
        </div>
      </div>
      <div style="font-size: 10px; color: #666; margin-top: 2px;">
        5D: {% if jpm_week_direction == "up" %}▲{% elsif jpm_week_direction == "down" %}▼{% else %}▪{% endif %} {{ jpm_week_change_pct }}%
      </div>
    </div>

  </div>

  <!-- Market news -->
  <div style="font-size: 11px; line-height: 1.3; color: #333; padding: 7px 0; border-top: 1px dashed #ccc;">
    <div style="font-weight: 700; text-transform: uppercase; font-size: 10px; letter-spacing: 0.5px; color: #666; margin-bottom: 3px;">Market news</div>
    <div style="margin-bottom: 2px;">• {{ why1 }}</div>
    {% if why2 and why2 != "" %}<div style="margin-bottom: 2px;">• {{ why2 }}</div>{% endif %}
    {% if why3 and why3 != "" %}<div style="margin-bottom: 2px;">• {{ why3 }}</div>{% endif %}
    {% if why4 and why4 != "" %}<div>• {{ why4 }}</div>{% endif %}
  </div>

  <!-- Trending tickers -->
  <div style="font-size: 11px; line-height: 1.3; color: #333; padding-top: 7px; border-top: 1px dashed #ccc;">
    <span style="font-weight: 700; text-transform: uppercase; font-size: 10px; letter-spacing: 0.5px; color: #666;">🔥 Trending today · </span>
    {{ trending }}
  </div>

</div>
